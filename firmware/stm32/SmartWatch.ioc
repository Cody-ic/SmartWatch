#MicroXplorer Configuration settings - do not modify
# Hardware initialization reference synchronized with Core/Src and FreeRTOSConfig.h.
# Runtime setup remains in application code; no generated source is imported.
# SPI2 keeps the current two-line HAL mode; only SCK/MOSI GPIOs are used.
# RTC: rtc_init(), LSI, async=127, sync=255; no automatic MX_RTC_Init call.
# IWDG: IWDG_Init() after application setup, /256, reload=500; no early MX_IWDG_Init call.
# Native tasks created in main.c: SensorTask (1536 words, priority 2),
# MicTask (512 words, priority 1), KWSTask (1024 words, priority 1).
# battery_init() sets PA4 to high impedance; sampling temporarily drives PA4 low.
